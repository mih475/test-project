//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}|{{ticker}}|{{strategy.order.action}}|{{strategy.order.contracts}}|{{strategy.order.price}}|{{time}}|{{timenow}}
strategy("Frozen MES ORB Candidate B — Paper", overlay=true, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.75,
     slippage=0, process_orders_on_close=false, calc_on_order_fills=true,
     calc_on_every_tick=false, use_bar_magnifier=false, precision=8)

// Frozen Candidate B: Candidate A plus ADX(14) >= 20 and +DI(14) > -DI(14).
const string TZ = "America/New_York"
const string RTH = "0930-1600:23456"
const int EMA_LEN = 50
const int ATR_LEN = 7
const float TARGET_ATR = 1.5
if barstate.isfirst and (not timeframe.isminutes or timeframe.multiplier != 15)
    runtime.error("Frozen Candidate B requires a 15-minute chart.")

bool inRth = not na(time(timeframe.period, RTH, TZ))
int dateKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
// Detect entry into RTH on ETH charts and the date change on RTH-only charts.
bool newSession = inRth and (not inRth[1] or na(dateKey[1]) or dateKey != dateKey[1])
bool openingBar = inRth and hour(time, TZ) == 9 and minute(time, TZ) == 30
bool eligibleSignalBar = inRth and hour(time, TZ) * 60 + minute(time, TZ) >= 9 * 60 + 45 and
     hour(time, TZ) * 60 + minute(time, TZ) < 15 * 60 + 45
bool finalRthBar = inRth and hour(time, TZ) == 15 and minute(time, TZ) == 45

// Fill callbacks manage the bracket only. They must not consume candle OHLC
// or advance the recursive indicator state. varip preserves committed updates
// across realtime fill callbacks; the bar-index guard prevents double updates.
varip float previousExecutionPosition = 0.0
varip int previousExecutionClosedTrades = 0
varip int lastProcessedBar = na
bool fillExecution = strategy.position_size != previousExecutionPosition or strategy.closedtrades != previousExecutionClosedTrades
previousExecutionPosition := strategy.position_size
previousExecutionClosedTrades := strategy.closedtrades
bool processClose = barstate.isconfirmed and not fillExecution and (na(lastProcessedBar) or lastProcessedBar != bar_index)
if processClose
    lastProcessedBar := bar_index

varip int rthCount = 0
varip float ema50Rth = na
varip float prevRthClose = na
varip float prevRthHigh = na
varip float prevRthLow = na
varip float atr7Seed = 0.0
varip float atr7Rth = na
varip float atr14Seed = 0.0
varip float atr14Rth = na
varip float plusSeed = 0.0
varip float minusSeed = 0.0
varip float plusRma = na
varip float minusRma = na
varip float adxSeed = 0.0
varip int adxSeedCount = 0
varip float adx14Rth = na
varip float plusDi14 = na
varip float minusDi14 = na
if processClose and inRth
    rthCount += 1
    float tr = na(prevRthClose) ? high - low :
         math.max(high - low, math.max(math.abs(high - prevRthClose), math.abs(low - prevRthClose)))
    float upMove = na(prevRthHigh) ? 0.0 : high - prevRthHigh
    float downMove = na(prevRthLow) ? 0.0 : prevRthLow - low
    float pdm = upMove > downMove and upMove > 0 ? upMove : 0.0
    float mdm = downMove > upMove and downMove > 0 ? downMove : 0.0
    ema50Rth := na(ema50Rth) ? close : ema50Rth + (2.0 / (EMA_LEN + 1.0)) * (close - ema50Rth)
    if rthCount <= ATR_LEN
        atr7Seed += tr
        if rthCount == ATR_LEN
            atr7Rth := atr7Seed / ATR_LEN
    else
        atr7Rth := (atr7Rth * (ATR_LEN - 1) + tr) / ATR_LEN
    if rthCount <= 14
        atr14Seed += tr
        plusSeed += pdm
        minusSeed += mdm
        if rthCount == 14
            atr14Rth := atr14Seed / 14.0
            plusRma := plusSeed / 14.0
            minusRma := minusSeed / 14.0
    else
        atr14Rth := (atr14Rth * 13.0 + tr) / 14.0
        plusRma := (plusRma * 13.0 + pdm) / 14.0
        minusRma := (minusRma * 13.0 + mdm) / 14.0
    if not na(atr14Rth) and atr14Rth > 0
        plusDi14 := 100.0 * plusRma / atr14Rth
        minusDi14 := 100.0 * minusRma / atr14Rth
    else
        plusDi14 := na
        minusDi14 := na
    float diSum = plusDi14 + minusDi14
    float dx = not na(diSum) and diSum > 0 ? 100.0 * math.abs(plusDi14 - minusDi14) / diSum : na
    if rthCount <= 14
        if not na(dx)
            adxSeed += dx
            adxSeedCount += 1
        if rthCount == 14 and adxSeedCount > 0
            adx14Rth := adxSeed / adxSeedCount
    else if not na(dx) and not na(adx14Rth)
        adx14Rth := (adx14Rth * 13.0 + dx) / 14.0
    prevRthClose := close
    prevRthHigh := high
    prevRthLow := low

varip float orHigh = na
varip float orLow = na
varip float signalAtr = na
varip float stopPrice = na
varip bool tradedToday = false
varip int lastSignalBar = na
if processClose and newSession
    orHigh := na
    orLow := na
    signalAtr := na
    stopPrice := na
    tradedToday := false
if processClose and openingBar
    orHigh := high
    orLow := low

bool longSignal = processClose and eligibleSignalBar and not na(orHigh) and
     not tradedToday and strategy.position_size == 0 and close > orHigh and close > ema50Rth and
     not na(atr7Rth) and not na(adx14Rth) and adx14Rth >= 20.0 and
     not na(plusDi14) and not na(minusDi14) and plusDi14 > minusDi14
if longSignal
    lastSignalBar := bar_index
    tradedToday := true
    signalAtr := atr7Rth
    stopPrice := orLow
    strategy.entry("B-L", strategy.long, qty=1,
         alert_message="B_ENTRY_FILL")
if strategy.position_size > 0 and not na(signalAtr) and not na(stopPrice)
    float targetPrice = strategy.position_avg_price + TARGET_ATR * signalAtr
    strategy.exit("B-X", from_entry="B-L", stop=stopPrice, limit=targetPrice,
         alert_message="B_BRACKET_EXIT")
if processClose and strategy.position_size > 0 and finalRthBar
    strategy.close("B-L", comment="RTH close", immediately=true,
         alert_message="B_RTH_CLOSE")

plot(orHigh, "Parity OR high", color=color.new(color.green, 55), style=plot.style_linebr)
plot(orLow, "Parity OR low / stop", color=color.new(color.red, 55), style=plot.style_linebr)
plot(ema50Rth, "Python-style RTH EMA50", color=color.new(color.orange, 0), display=display.data_window)
plot(atr7Rth, "Python-style RTH ATR7", color=color.new(color.blue, 0), display=display.data_window)
plot(adx14Rth, "Python-style RTH ADX14", color=color.new(color.purple, 0), display=display.data_window)
plot(plusDi14, "Python-style RTH +DI14", color=color.new(color.teal, 0), display=display.data_window)
plot(minusDi14, "Python-style RTH -DI14", color=color.new(color.red, 0), display=display.data_window)
plot(lastSignalBar == bar_index ? 1 : 0, "Parity long signal (1/0)", display=display.data_window)

plot(rthCount, "Parity RTH bar count", display=display.data_window)
plot(strategy.position_size > 0 ? strategy.position_avg_price + TARGET_ATR * signalAtr : na, "Parity target", display=display.data_window)
plot(signalAtr, "Parity captured ATR", display=display.data_window)
